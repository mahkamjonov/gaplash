# Public URL of the app. Used for metadata and as a fallback when building sign-in links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project settings. Leave these empty to run in mock mode: sample data and a
# pretend sign-in, with no backend. Setting both turns on real auth and the database.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# LiveKit Cloud, for audio and video in the practice room. The URL starts with wss://.
# The secret stays on the server and must never be shared or committed.
NEXT_PUBLIC_LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
